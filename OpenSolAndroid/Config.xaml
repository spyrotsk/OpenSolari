<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolAndroid.Config"
             Title="Server Configuration">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label 
                Text="Server Configuration"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
                
            <Label Text="Server IP Address (Windows PC)" />
            <Entry x:Name="txtServerIP" Placeholder="e.g. 192.168.1.10" />
            
            <Label Text="Server Port" />
            <Entry x:Name="txtServerPort" Keyboard="Numeric" Placeholder="e.g. 8080" Text="8080" />
    
            <Label Text="Authentication Token (Optional)" />
            <Entry x:Name="txtToken" IsPassword="True" Placeholder="Enter secret key" />
    
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Use HTTPS" VerticalOptions="Center" />
                <Switch x:Name="swUseHttps" />
            </HorizontalStackLayout>
    
            <BoxView HeightRequest="1" Color="Gray" Margin="0,5,0,5" />
            <Label Text="Geolock Configuration" FontAttributes="Bold" />
            <Label Text="Click below to set target location on map or clear saved coordinates." TextColor="Gray" FontSize="Small" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" 
                        x:Name="btnGeolocate" 
                        Text="📍 Set Target on Map" 
                        Clicked="OnGeolocateClicked" 
                        BackgroundColor="DarkGreen" 
                        TextColor="White" />
                <Button Grid.Column="1" 
                        x:Name="btnClearLocation" 
                        Text="🗑️ Clear Location" 
                        Clicked="OnClearLocationClicked" 
                        BackgroundColor="DarkRed" 
                        TextColor="White" />
            </Grid>
    
            <Label x:Name="lblTargetCoords" Text="Target: Not set" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,5,0,5" />

            <VerticalStackLayout Spacing="5" Margin="0,5,0,10">
                <Label x:Name="lblGeofenceRadius" 
                       Text="Max Allowed Distance Radius: 500 m" 
                       FontAttributes="Bold" 
                       FontSize="Small" />
                <Slider x:Name="sldGeofenceRadius" 
                        Minimum="50" 
                        Maximum="5000" 
                        Value="500" 
                        ValueChanged="OnRadiusSliderValueChanged" />
                <Grid ColumnDefinitions="*,*">
                    <Label Grid.Column="0" Text="50 m" FontSize="Micro" TextColor="Gray" HorizontalOptions="Start" />
                    <Label Grid.Column="1" Text="5000 m (5 km)" FontSize="Micro" TextColor="Gray" HorizontalOptions="End" />
                </Grid>
            </VerticalStackLayout>

            <Label Text="Geolocation Accuracy Level" FontAttributes="Bold" FontSize="Small" Margin="0,5,0,0" />
            <Picker x:Name="pkrGeoAccuracy" Title="Select Accuracy Mode">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Best</x:String>
                        <x:String>High</x:String>
                        <x:String>Medium</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
    
            <Button Text="Manage Home Screen Buttons" 
                    Clicked="OnManageButtonsClicked" 
                    BackgroundColor="{StaticResource Secondary}" 
                    TextColor="White"
                    Margin="0,10,0,0" />
    
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Export Config" Clicked="OnExportClicked" BackgroundColor="Gray" TextColor="White" />
                <Button Grid.Column="1" Text="Import Config" Clicked="OnImportClicked" BackgroundColor="Gray" TextColor="White" />
            </Grid>
    
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Save" Clicked="OnSaveClicked" />
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>